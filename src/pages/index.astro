---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import MembershipSection from '../components/MembershipSection.astro';
import TrainersSection from '../components/TrainersSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import ScheduleLocationSection from '../components/ScheduleLocationSection.astro';
import { site } from '../config/site';
---

<BaseLayout title={site.name} description={site.description}>
  <Hero />
  <ServicesSection />
  <MembershipSection />
  <TrainersSection />
  <FacilitiesSection />
  <FAQSection />
  <CTASection />
  <ScheduleLocationSection />
</BaseLayout>
