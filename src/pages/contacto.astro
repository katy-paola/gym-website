---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScheduleLocationSection from '../components/ScheduleLocationSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../config/site';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Contacto"
  description="Contacta Snap Fitness por WhatsApp o teléfono, consulta horarios, ubicación y agenda una visita o clase de prueba."
>
  <section class="page-hero">
    <div class="container">
      <span class="section__eyebrow">Contacto</span>
      <h1>Hablemos de tu plan</h1>
      <p>
        La forma más rápida de contactarnos es WhatsApp. También puedes llamarnos o visitarnos en
        nuestro horario de atención.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container channels">
      <a
        class="channel channel--wa"
        href={`${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`}
        target="_blank"
        rel="noopener"
      >
        <h2>WhatsApp</h2>
        <p>Resolvemos dudas, enviamos precios y agendamos tu visita.</p>
        <span class="channel__action">{site.phoneDisplay} →</span>
      </a>

      <a class="channel" href={`tel:${site.phoneRaw.replace('+', '')}`}>
        <span class="channel__icon"><Icon name="phone" /></span>
        <h2>Llamada</h2>
        <p>¿Prefieres hablar? Llámanos y te atendemos en horario de atención.</p>
        <span class="channel__action">{site.phoneDisplay} →</span>
      </a>

      <a class="channel" href={site.instagram} target="_blank" rel="noopener">
        <span class="channel__icon"><Icon name="ig" /></span>
        <h2>Instagram</h2>
        <p>Contenido, motivación y comunidad. Para el día a día del gimnasio.</p>
        <span class="channel__action">{site.instagramHandle} →</span>
      </a>
    </div>
  </section>

  <ScheduleLocationSection />
  <FAQSection />
  <CTASection />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(115deg, var(--color-dark), #1a0b10 60%, var(--color-primary-dark));
    color: #fff;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }

  .page-hero .section__eyebrow {
    color: #ff9aab;
  }

  .page-hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 0.75rem;
  }

  .page-hero p {
    max-width: 56ch;
    color: #e8eaef;
    font-size: 1.08rem;
    margin: 0;
  }

  .channels {
    display: grid;
    gap: 1.25rem;
  }

  .channel {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .channel:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .channel--wa {
    background: #f0fdf4;
    border-color: #bbf7d0;
  }

  .channel--wa:hover {
    border-color: #25d366;
  }

  .channel__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    margin-bottom: 0.85rem;
  }

  .channel h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .channel p {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .channel__action {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  @media (min-width: 800px) {
    .channels {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
