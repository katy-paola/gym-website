---
import { site } from '../config/site';

const href = `${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1800&h=1200&fit=crop"
      alt=""
      width="1800"
      height="1200"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__eyebrow">Gimnasio · Entrenamiento personalizado</p>
    <h1 class="hero__title">
      Entrena a tu ritmo.<br />
      <span>Alcanza tus metas.</span>
    </h1>
    <p class="hero__lead">
      Un espacio moderno y accesible con acceso libre al gimnasio y planes de entrenamiento
      personalizado para principiantes y avanzados.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={href} target="_blank" rel="noopener">
        Agenda tu visita por WhatsApp
      </a>
      <a class="btn btn--ghost" href="#servicios">Ver servicios</a>
    </div>
    <ul class="hero__badges">
      <li>Acceso libre</li>
      <li>Planes flexibles</li>
      <li>Entrenadores certificados</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(540px, 88vh, 760px);
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(10, 11, 15, 0.92) 0%, rgba(10, 11, 15, 0.72) 45%, rgba(228, 0, 43, 0.35) 100%),
      linear-gradient(to top, rgba(10, 11, 15, 0.6), transparent 45%);
  }

  .hero__content {
    position: relative;
    padding-block: clamp(4rem, 10vw, 7rem);
    max-width: 720px;
    margin-left: max(var(--gutter), calc((100% - var(--container)) / 2));
    margin-right: var(--gutter);
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff8fa3;
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero__title span {
    color: var(--color-primary);
    text-shadow: 0 2px 24px rgba(228, 0, 43, 0.45);
  }

  .hero__lead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #e7e9ef;
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero__badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
  }

  .hero__badges li {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
  }
</style>
