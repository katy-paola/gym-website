---
import { membership, trainingSteps, trainingForWho, site } from '../config/site';
import Icon from './Icon.astro';

type Plan = (typeof membership.plans)[number];

function ctaHref(plan: Plan): string {
  const msg = plan.price
    ? `Hola, me interesa el plan "${plan.name}" (${plan.price} ${plan.period}) de Snap Fitness.`
    : `Hola, me interesa el entrenamiento personalizado. ¿Me pueden cotizar?`;
  return `${site.whatsapp}?text=${encodeURIComponent(msg)}`;
}

const evalHref = `${site.whatsapp}?text=${encodeURIComponent('Hola, me interesa el entrenamiento personalizado. ¿Cómo agendo una evaluación?')}`;
---

<section class="section section--alt" id="membresia">
  <div class="container">
    <header class="section__head reveal">
      <span class="section__eyebrow">Membresía</span>
      <h2 class="section__title">Qué incluye tu membresía</h2>
      <p class="section__lead">
        Precios claros desde el primer momento. Reserva el día o el mes por WhatsApp; el
        entrenamiento personalizado se cotiza según tus objetivos.
      </p>
    </header>

    <div class="grid grid--3 plans">
      {membership.plans.map((plan, i) => (
        <article class:list={['plan', 'reveal', { 'plan--featured': plan.highlighted }]} style={`--i:${i}`}>
          {plan.highlighted && <span class="plan__tag">Recomendado</span>}
          <h3 class="plan__name">{plan.name}</h3>
          {plan.price ? (
            <p class="plan__price">{plan.price}</p>
          ) : (
            <p class="plan__price plan__price--alt">A cotizar</p>
          )}
          <p class="plan__period">{plan.period}</p>
          <ul class="plan__features">
            {plan.features.map((f) => (
              <li><Icon name="check" /> {f}</li>
            ))}
          </ul>
          <a
            class:list={['btn', plan.highlighted ? 'btn--primary' : 'btn--outline', 'plan__cta']}
            href={ctaHref(plan)}
            target="_blank"
            rel="noopener"
          >
            {plan.cta}
          </a>
        </article>
      ))}
    </div>

    <div class="training reveal" id="entrenamiento">
      <header class="training__head">
        <span class="section__eyebrow">Entrenamiento personalizado</span>
        <h3 class="training__title">Cómo funciona, paso a paso</h3>
        <p class="training__lead">
          No es una rutina genérica. Diseñamos un plan según tus objetivos y lo ajustamos según tus
          resultados.
        </p>
      </header>

      <ol class="steps">
        {trainingSteps.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step__num">{s.step}</span>
            <h4 class="step__title">{s.title}</h4>
            <p class="step__text">{s.description}</p>
          </li>
        ))}
      </ol>

      <div class="forwho reveal">
        <div>
          <h4 class="forwho__title">Para quién es</h4>
          <ul class="forwho__list">
            {trainingForWho.map((item) => (
              <li><span class="forwho__check"><Icon name="check" /></span> {item}</li>
            ))}
          </ul>
        </div>
        <div class="forwho__cta">
          <h4>¿Listo para empezar con un plan a tu medida?</h4>
          <p>
            Agenda tu evaluación inicial por WhatsApp. Puedes indicar el entrenador que prefieras; si
            no especificas ninguno, te atiende el equipo disponible.
          </p>
          <a class="btn btn--primary" href={evalHref} target="_blank" rel="noopener">
            Quiero mi evaluación
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plan {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .plan--featured {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .plan__tag {
    position: absolute;
    top: -12px;
    left: 1.5rem;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .plan__name {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }

  .plan__price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    line-height: 1;
  }

  .plan__price--alt {
    font-size: 1.55rem;
    color: var(--color-ink);
  }

  .plan__period {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0.35rem 0 1.25rem;
  }

  .plan__features {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    flex: 1;
  }

  .plan__features li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plan__features :global(svg) {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .plan__cta {
    width: 100%;
  }

  .training {
    margin-top: clamp(4rem, 9vw, 6rem);
    padding-top: clamp(3rem, 7vw, 4.5rem);
    border-top: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--header-h) + 12px);
  }

  .training__head {
    max-width: 640px;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .training__title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    margin: 0.4rem 0 0.5rem;
  }

  .training__lead {
    color: var(--color-ink-soft);
    margin: 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .step {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 3vw, 1.85rem) clamp(1.35rem, 2.5vw, 1.6rem);
  }

  .step__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .step__title {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .step__text {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }

  .forwho {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .forwho__title {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }

  .forwho__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .forwho__list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    color: var(--color-ink-soft);
    font-weight: 500;
    font-size: 0.97rem;
  }

  .forwho__check {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .forwho__cta {
    background: var(--color-dark);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    align-self: start;
  }

  .forwho__cta h4 {
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    margin-bottom: 0.5rem;
  }

  .forwho__cta p {
    color: #c7cbd4;
    margin: 0 0 1.25rem;
    max-width: 48ch;
    font-size: 0.97rem;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .forwho {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
      gap: 2.5rem;
    }
  }

  @media (max-width: 719px) {
    .plan--featured {
      transform: none;
    }
  }
</style>
