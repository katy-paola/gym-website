---
import { trainingSteps, site } from '../config/site';

const href = `${site.whatsapp}?text=${encodeURIComponent('Hola, me interesa el entrenamiento personalizado. ¿Cómo agendo una evaluación?')}`;
---

<section class="section" id="entrenamiento">
  <div class="container">
    <header class="section__head">
      <span class="section__eyebrow">Entrenamiento personalizado</span>
      <h2 class="section__title">Cómo funciona, paso a paso</h2>
      <p class="section__lead">
        No es una rutina genérica. Diseñamos un plan según tus objetivos y lo ajustamos según tus
        resultados.
      </p>
    </header>

    <ol class="steps">
      {trainingSteps.map((s) => (
        <li class="step">
          <span class="step__num">{s.step}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.description}</p>
        </li>
      ))}
    </ol>

    <div class="cta">
      <div>
        <h3>¿Listo para empezar con un plan a tu medida?</h3>
        <p>Agenda tu evaluación inicial por WhatsApp. Te respondemos con la disponibilidad.</p>
      </div>
      <a class="btn btn--primary" href={href} target="_blank" rel="noopener">
        Quiero mi evaluación
      </a>
    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    counter-reset: none;
  }

  .step {
    position: relative;
    background: var(--color-surface-alt);
    border-radius: var(--radius-md);
    padding: 1.65rem 1.5rem 1.5rem;
    border-left: 4px solid var(--color-primary);
  }

  .step__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .step__title {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .step__text {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }

  .cta {
    margin-top: 2.5rem;
    background: var(--color-dark);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .cta h3 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    margin-bottom: 0.35rem;
  }

  .cta p {
    color: #c7cbd4;
    margin: 0;
    max-width: 48ch;
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }
</style>
