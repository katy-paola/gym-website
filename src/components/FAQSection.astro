---
import { faqs } from '../config/site';
---

<section class="section" id="faq">
  <div class="container faq">
    <header class="section__head">
      <span class="section__eyebrow">Preguntas frecuentes</span>
      <h2 class="section__title">Respuestas antes de que preguntes</h2>
      <p class="section__lead">
        Si tu duda no está aquí, escríbenos por WhatsApp y te respondemos rápido.
      </p>
    </header>

    <div class="faq__list">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 820px;
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.25rem 1.15rem;
    transition: border-color 0.15s ease;
  }

  .faq__item[open] {
    border-color: var(--color-primary);
  }

  .faq__item summary {
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: 1rem;
    padding: 1rem 0;
    position: relative;
    padding-right: 2rem;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1;
  }

  .faq__item[open] summary::after {
    content: '–';
  }

  .faq__item p {
    margin: 0 0 1.1rem;
    color: var(--color-ink-soft);
    font-size: 0.97rem;
    max-width: 65ch;
  }
</style>
