---
import { trainers, site } from '../config/site';

function waHref(name: string): string {
  const msg = `Hola, me interesa el entrenamiento personalizado con ${name}. ¿Podemos agendar una evaluación?`;
  return `${site.whatsapp}?text=${encodeURIComponent(msg)}`;
}
---

<section class="section section--alt" id="equipo">
  <div class="container">
    <header class="section__head">
      <span class="section__eyebrow">Equipo</span>
      <h2 class="section__title">Entrenadores que te acompañan</h2>
      <p class="section__lead">
        Profesionales dedicados a guiarte con técnica, constancia y un trato cercano en cada sesión.
      </p>
    </header>

    <div class="grid grid--2">
      {trainers.map((t) => (
        <article class="trainer">
          <div class="trainer__photo" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="100%" height="100%" fill="currentColor" aria-hidden="true">
              <circle cx="32" cy="24" r="12" />
              <path d="M32 40c-12 0-20 7-22 16a34 34 0 0 0 44 0c-2-9-10-16-22-16z" />
            </svg>
          </div>
          <div class="trainer__body">
            <span class="trainer__role">{t.role}</span>
            <h3 class="trainer__name">{t.name}</h3>
            <p class="trainer__specialty">{t.specialty}</p>
            <a class="btn btn--outline trainer__cta" href={waHref(t.name)} target="_blank" rel="noopener">
              Entrenamiento personalizado
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .trainer {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .trainer__photo {
    aspect-ratio: 1;
    overflow: hidden;
    background: #e4e7ed;
    color: #7d8593;
    display: grid;
    place-items: center;
    padding: 18%;
  }

  .trainer__body {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .trainer__role {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .trainer__name {
    font-size: 1.15rem;
    margin: 0.35rem 0 0.2rem;
  }

  .trainer__specialty {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    margin-bottom: 0.6rem;
  }

  .trainer__cta {
    width: 100%;
  }
</style>
