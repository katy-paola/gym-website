---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section class="section section--alt" id="instagram">
  <div class="container ig">
    <div>
      <span class="section__eyebrow">Comunidad</span>
      <h2 class="section__title">Síguenos en Instagram</h2>
      <p class="section__lead">
        Motivación, consejos, retos y el día a día de la comunidad. La web te explica el negocio;
        Instagram te mantiene en movimiento.
      </p>
      <a class="btn btn--primary" href={site.instagram} target="_blank" rel="noopener">
        <Icon name="ig" /> {site.instagramHandle}
      </a>
    </div>

    <div class="ig__card">
      <p class="ig__quote">“Constantancia beats motivación.”</p>
      <ul>
        <li>Contenido y tips de entrenamiento</li>
        <li>Retos y comunidad</li>
        <li>Novedades del gimnasio</li>
      </ul>
      <a class="ig__link" href={site.instagram} target="_blank" rel="noopener">
        Ver perfil <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .ig {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .ig .btn {
    margin-top: 0.5rem;
  }

  .ig__card {
    background: var(--color-dark);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-md);
  }

  .ig__quote {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .ig__card ul {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    color: #c7cbd4;
    font-size: 0.97rem;
  }

  .ig__card li::before {
    content: '•';
    color: var(--color-primary);
    margin-right: 0.55rem;
    font-weight: 900;
  }

  .ig__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: #fff;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 0.15rem;
  }

  .ig__link:hover {
    color: var(--color-primary);
  }

  @media (min-width: 860px) {
    .ig {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }
  }
</style>
