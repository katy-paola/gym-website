---
import { site } from '../config/site';

const href = `${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section class="section cta" id="contacto-cta">
  <div class="container cta__inner">
    <div>
      <h2>¿Te gustaría entrenar con nosotros?</h2>
      <p>
        Escríbenos por WhatsApp al <strong>{site.phoneDisplay}</strong> y agenda una visita o una
        clase de prueba sin compromiso.
      </p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={href} target="_blank" rel="noopener">
        Escribir por WhatsApp
      </a>
      <a class="btn btn--ghost" href={`tel:${site.phoneRaw.replace('+', '')}`}>
        Llamar ahora
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      linear-gradient(120deg, rgba(228, 0, 43, 0.95), rgba(184, 0, 35, 0.92)),
      url('https://images.unsplash.com/photo-1571902943202-507ec2618e8f?w=1600&h=700&fit=crop')
        center / cover;
    color: #fff;
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .cta h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin-bottom: 0.5rem;
    max-width: 18ch;
  }

  .cta p {
    max-width: 52ch;
    color: #ffe8ed;
    margin: 0;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .cta .btn--primary {
    background: #fff;
    color: var(--color-primary);
  }

  .cta .btn--primary:hover {
    background: var(--color-dark);
    color: #fff;
  }
</style>
